  "iconId": "ic_lib_stripe",
  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "Stripe SDK",
        "dev_team": "Stripe",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "Stripe Android SDK 让你能够在 Android 应用中快速、轻松地构建出色的支付体验。我们提供功能强大且可自定义的 UI 元素，可直接用于收集用户的支付信息。同时，我们也提供支持这些 UI 的底层 API，方便你构建完全自定义的支付体验。",
        "source_link": "https://github.com/stripe/stripe-android"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Stripe SDK",
        "dev_team": "Stripe",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "The Stripe Android SDK makes it quick and easy to build an excellent payment experience in your Android app. We provide powerful and customizable UI elements that can be used out-of-the-box to collect your users' payment details. We also expose the low-level APIs that power those UIs so that you can build fully custom experiences.",
        "source_link": "https://github.com/stripe/stripe-android"
      }
    }
  ],
