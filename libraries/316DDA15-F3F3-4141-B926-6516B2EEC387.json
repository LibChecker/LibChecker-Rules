  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "Google Tag Manager",
        "dev_team": "Google",
        "rule_contributors": [
          "sebastien46"
        ],
        "description": "作为开发者，你可以使用 Google Tag Manager 在移动应用中实现和管理衡量代码和像素，而无需重新构建应用二进制文件并重新提交到应用市场。使用 Google Analytics for Firebase SDK 的开发者可以轻松添加 Tag Manager，以便即使在应用发布后也能管理实现并进行变更。",
        "source_link": "https://developers.google.com/tag-platform/tag-manager/android/v5"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Google Tag Manager",
        "dev_team": "Google",
        "rule_contributors": [
          "sebastien46"
        ],
        "description": "As a developer, you can use Google Tag Manager to implement and manage measurement tags and pixels in your mobile applications, without having to rebuild and resubmit application binaries to app marketplaces. Developers who work with the Google Analytics for Firebase SDK can easily add Tag Manager to help manage and make changes to the implementation, even after the app has shipped.",
        "source_link": "https://developers.google.com/tag-platform/tag-manager/android/v5"
      }
    }
  ],
