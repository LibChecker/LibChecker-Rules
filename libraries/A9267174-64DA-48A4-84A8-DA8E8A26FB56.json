    {
      "locale": "zh-Hans",
      "data": {
        "label": "AR Engine",
        "dev_team": "Huawei",
        "rule_contributors": [
          "Absinthe",
          "crrashh1542"
        ],
        "description": "HUAWEI AR Engine 是一个用于在 Android 上构建增强现实应用的平台。HUAWEI AR Engine 基于海思芯片平台整合 AR 核心算法提供了运动跟踪、环境跟踪、人体和人脸跟踪等 AR 基础能力，通过这些能力可让您的应用实现虚拟世界与现实世界的融合，为您的应用提供全新的视觉体验和交互方式。",
        "source_link": "https://developer.huawei.com/consumer/cn/doc/development/HMSCore-Guides/introduction-0000001050130900"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "AR Engine",
        "dev_team": "Huawei",
        "rule_contributors": [
          "Absinthe",
          "crrashh1542"
        ],
        "description": "HUAWEI AR Engine is a platform for building augmented reality applications on Android. Based on the HiSilicon chip platform, HUAWEI AR Engine integrates AR core algorithms to provide basic AR capabilities such as motion tracking, environment tracking, body and face tracking. These capabilities can enable your application to achieve the fusion of the virtual world and the real world, providing a new visual experience and interaction method for your application.",
        "source_link": "https://developer.huawei.com/consumer/cn/doc/development/HMSCore-Guides/introduction-0000001050130900"
      }
    }
  ],
