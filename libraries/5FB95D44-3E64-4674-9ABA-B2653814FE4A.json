    {
      "locale": "zh-Hans",
      "data": {
        "label": "vivo Push",
        "dev_team": "vivo",
        "rule_contributors": [
          "Absinthe",
          "xiwuwww"
        ],
        "description": "vivo 推送（即 vpush）是 vivo 公司向开发者提供的消息推送服务，通过在云端与客户端之间建立一条稳定、可靠的长连接，为开发者提供向客户端应用实时推送消息的服务，支持百亿级的通知/消息推送，秒级触达移动用户。",
        "source_link": "https://push.vivo.com.cn/"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "vivo Push",
        "dev_team": "vivo",
        "rule_contributors": [
          "Absinthe",
          "xiwuwww"
        ],
        "description": "vivo Push (i.e., vPush) is a message push service provided by vivo for developers. By establishing a stable and reliable long connection between the cloud and client devices, it enables developers to deliver real-time messages to client applications, supporting 10-billion-level notification and message pushes with second-level delivery to mobile users.",
        "source_link": "https://push.vivo.com.cn/"
      }
    }
  ],
