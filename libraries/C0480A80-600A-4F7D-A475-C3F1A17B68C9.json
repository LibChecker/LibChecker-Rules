    {
      "locale": "zh-Hans",
      "data": {
        "label": "TUTK SDK",
        "dev_team": "TUTK",
        "rule_contributors": [
          "ArthurCyy"
        ],
        "description": "IOTC（物联网云）平台是 Throughtek (TUTK) 所开发的基于云平台的物联网解决方案。它利用 P2P 连接技术与云计算，加上跨平台 API，使得不同的互联网设备之间可以建立跨平台的连接。使用 TUTK 提供的 SDK 所开发的网络摄像机客户端与服务端，会被嵌入 IOTC 库，用于与 TUTK 服务器通讯，并建立 P2P 连接。",
        "source_link": "https://www.throughtek.cn/"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "TUTK SDK",
        "dev_team": "TUTK",
        "rule_contributors": [
          "ArthurCyy"
        ],
        "description": "IOTC (Internet of Things Cloud) platform is a cloud-based IoT solution developed by Throughtek (TUTK). It utilizes P2P connection technology and cloud computing, along with cross-platform APIs, enabling cross-platform connections between different internet devices. The network camera client and server developed using the SDK provided by TUTK will be embedded with the IOTC library for communication with TUTK servers and establishing P2P connections.",
        "source_link": "https://www.throughtek.cn/"
      }
    }
  ],
