  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "Play Asset Delivery",
        "dev_team": "Google",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "Play Asset Delivery (PAD) 将应用包的优势带入游戏。它允许大于 200MB 的游戏通过发布一个包含游戏所需所有资源的单一工件来替代传统的扩展文件 (OBBs)。PAD 提供灵活的交付模式、自动更新、压缩和增量修补，并且免费使用。",
        "source_link": "https://developer.android.com/guide/playcore/asset-delivery"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Play Asset Delivery",
        "dev_team": "Google",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "Play Asset Delivery (PAD) brings the benefits of app bundles to games. It allows games larger than 200MB to replace legacy expansion files (OBBs) by publishing a single artifact to Play containing all the resources the game needs. PAD offers flexible delivery modes, auto-updates, compression, and delta patching, and is free to use.",
        "source_link": "https://developer.android.com/guide/playcore/asset-delivery"
      }
    }
  ],
