      "data": {
        "label": "招商银行 SDK",
        "dev_team": "CMB",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "为保证用户输入支付密码时的输入安全，招行自主开发了安全输入键盘，以 SDK 形式供商户集成到 APP 中，配合招行一网通支付使用，保护用户的密码安全。分为 Android 版和 iOS 版。",
        "source_link": "http://link.cmbchina.com/open/pwdpay/sdk/default.aspx"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "CMBC SDK",
        "dev_team": "CMB",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "To ensure input security when users enter payment passwords, China Merchants Bank independently developed a secure input keyboard, provided in SDK form for merchants to integrate into apps, used in conjunction with China Merchants Bank's OneNetPay to protect users' password security. Available in Android and iOS versions.",
        "source_link": "http://link.cmbchina.com/open/pwdpay/sdk/default.aspx"
      }
    }
  ],
