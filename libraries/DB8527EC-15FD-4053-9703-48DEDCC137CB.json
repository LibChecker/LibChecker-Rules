      "data": {
        "label": "Google Cast",
        "dev_team": "Google",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "使用 Google Cast SDK，您可以扩展 Android，iOS 或 Chrome 应用，以将其流式视频和音频定向到电视或声音系统。 您的应用程序成为播放，暂停，搜索，倒带，停止和控制媒体的遥控器。",
        "source_link": "https://developers.google.com/cast/"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Google Cast",
        "dev_team": "Google",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "Using the Google Cast SDK, you can extend Android, iOS, or Chrome apps to direct their streaming video and audio to a TV or sound system. Your app becomes a remote control for playing, pausing, searching, rewinding, stopping, and controlling media.",
        "source_link": "https://developers.google.com/cast/"
      }
    }
  ],
