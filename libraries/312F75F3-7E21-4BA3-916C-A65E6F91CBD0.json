        ],
        "description": "uni-app is a framework for developing all front-end applications using Vue.js. Developers write one set of code and can publish it to iOS, Android, HarmonyOS Next, Web (responsive), and various mini programs, quick apps, and HarmonyOS services.",
        "source_link": "https://uniapp.dcloud.net.cn/"
      }
