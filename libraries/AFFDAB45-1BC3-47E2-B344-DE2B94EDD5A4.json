      "data": {
        "label": "银联 SDK",
        "dev_team": "银联",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "银联在线支付网关是中国银联联合各商业银行为持卡人提供的集成化、综合性互联网支付工具，主要支持输入卡号付款、用户登录支付、网银支付、迷你付（IC 卡支付）等多种支付方式，为持卡人提供境内外网上购物、水电煤缴费、商旅预订等支付服务。",
        "source_link": "https://open.unionpay.com/"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "UnionPay SDK",
        "dev_team": "银联",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "UnionPay Online Payment Gateway is an integrated, comprehensive internet payment tool provided by China UnionPay in collaboration with commercial banks. It mainly supports various payment methods such as card number input payment, user login payment, online banking payment, and mini payment (IC card payment), offering cardholders services for domestic and international online shopping, utility bill payments, travel bookings, and more.",
        "source_link": "https://open.unionpay.com/"
      }
    }
