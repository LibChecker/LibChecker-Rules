  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "腾讯移动推送",
        "dev_team": "Tencent",
        "rule_contributors": [
          "Absinthe",
          "ArthurCyy"
        ],
        "description": "移动推送 TPNS（Tencent Push Notification Service）为您提供稳定、快速高抵达的 APP 推送服务。其接入方便快捷，拥有行业前沿的技术实力，稳定可靠的消息推送通道，独有可自选的双 Service 联合保活服务，能有效提升消息抵达率；系统每分钟可容纳1800万推送消息，消息能秒级到达（支撑王者荣耀等腾讯内应用推送工具）；此外，其具备精准用户标签能力，有效助力 APP 的精细化运营。 ",
        "source_link": "https://cloud.tencent.com/product/tpns"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Tencent Mobile Push",
        "dev_team": "Tencent",
        "rule_contributors": [
          "Absinthe",
          "ArthurCyy"
        ],
        "description": "Mobile Push TPNS (Tencent Push Notification Service) provides you with stable, fast, and high-reach app push services. Its integration is convenient and fast, with industry-leading technical strength, stable and reliable message push channels, and a unique optional dual-Service joint keep-alive service, effectively improving message reach rate; the system can accommodate 18 million push messages per minute, with messages reaching in seconds (supporting Tencent internal applications like Honor of Kings); additionally, it has precise user tag capabilities, effectively assisting in refined app operations.",
        "source_link": "https://cloud.tencent.com/product/tpns"
      }
    }
  ],
