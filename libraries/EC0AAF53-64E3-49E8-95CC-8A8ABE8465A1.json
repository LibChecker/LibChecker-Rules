    {
      "locale": "zh-Hans",
      "data": {
        "label": "BytePlus RTC",
        "dev_team": "ByteDance",
        "rule_contributors": [
          "yfdyh000"
        ],
        "description": "BytePlus RTC 支持全球范围内高可靠、高并发且低延迟的实时通信，并提供允许各种形式在线互动的服务。",
        "source_link": "https://docs.byteplus.com/zh-CN/docs/byteplus-rtc/docs-66812"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "BytePlus RTC",
        "dev_team": "ByteDance",
        "rule_contributors": [
          "yfdyh000"
        ],
        "description": "BytePlus RTC enables highly reliable, concurrent and low latency real-time communication across the globe and provides a service that allows various forms of online interaction.",
        "source_link": "https://docs.byteplus.com/zh-CN/docs/byteplus-rtc/docs-66812"
      }
    }
