  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "MSAL",
        "dev_team": "Microsoft",
        "rule_contributors": [
          "sebastien46"
        ],
        "description": "适用于 Android 的 Microsoft Authentication Library (MSAL) 是一个库，可让 Android 应用通过 Microsoft 标识平台（前身为 Azure Active Directory）对用户进行身份验证，并使用 OAuth2 和 OpenID Connect 协议访问受保护的 Web API。MSAL Android 让开发者可以从 Microsoft 标识平台获取安全令牌，用于为基于 Android 的应用进行用户身份验证并访问安全的 Web API。",
        "source_link": "https://github.com/AzureAD/microsoft-authentication-library-for-android"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "MSAL",
        "dev_team": "Microsoft",
        "rule_contributors": [
          "sebastien46"
        ],
        "description": "The Microsoft Authentication Library (MSAL) for Android is a library that enables Android applications to authenticate users with Microsoft identity platform (formerly Azure Active Directory) and access protected web APIs using OAuth2 and OpenID Connect protocols. MSAL Android enables developers to acquire security tokens from the Microsoft identity platform to authenticate users and access secure web APIs for their Android based applications.",
        "source_link": "https://github.com/AzureAD/microsoft-authentication-library-for-android"
      }
    }
  ],
