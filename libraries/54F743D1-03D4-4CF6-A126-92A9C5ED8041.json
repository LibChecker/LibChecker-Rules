  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "Ascend CANN",
        "dev_team": "HUAWEI",
        "rule_contributors": [
          "ArthurCyy",
          "WOLFRAZOR",
          "ArcticFoxPro"
        ],
        "description": "CANN（Compute Architecture for Neural Networks）是华为针对 AI 场景推出的异构计算架构，对上支持多种 AI 框架，对下服务 AI 处理器与编程，发挥承上启下的关键作用，是提升昇腾 AI 处理器计算效率的关键平台。",
        "source_link": "https://developer.huawei.com/consumer/cn/hiai#Foundation"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Ascend CANN",
        "dev_team": "HUAWEI",
        "rule_contributors": [
          "ArthurCyy",
          "WOLFRAZOR",
          "ArcticFoxPro"
        ],
        "description": "CANN (Compute Architecture for Neural Networks) is a heterogeneous computing architecture introduced by Huawei for AI scenarios. It supports multiple AI frameworks at the upper layer and serves AI processors and programming at the lower layer, playing a key bridging role. It is a critical platform for improving the computing efficiency of Ascend AI processors.",
        "source_link": "https://developer.huawei.com/consumer/cn/hiai#Foundation"
      }
    }
  ],
