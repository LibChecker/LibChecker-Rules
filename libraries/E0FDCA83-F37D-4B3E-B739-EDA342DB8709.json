  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "PixUI",
        "dev_team": "Tencent",
        "rule_contributors": [
          "crrashh1542"
        ],
        "description": "PixUI 是一个实现了 H5ES 标准的跨平台 UI 引擎，旨在将强大易用的 H5 技术和工作流引入游戏和原生 App 开发，让开发者快速开发出与游戏引擎原生效果一致的 UI 界面，并通过 GPU 实现毫秒级渲染。",
        "source_link": "https://gamelet.qq.com/pixui/"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "PixUI",
        "dev_team": "Tencent",
        "rule_contributors": [
          "crrashh1542"
        ],
        "description": "PixUI is a cross-platform UI engine implementing the H5ES standard, designed to bring powerful and user-friendly H5 technology and workflows to game and native app development. It allows developers to quickly create UIs matching native game engine effects, achieving millisecond-level rendering via the GPU.",
        "source_link": "https://gamelet.qq.com/pixui/"
      }
    }
  ],
