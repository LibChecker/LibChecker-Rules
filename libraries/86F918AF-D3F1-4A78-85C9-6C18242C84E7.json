        "dev_team": "Google",
        "rule_contributors": [
          "IveTian"
        ],
        "description": "LiquidFun is an extension of Box2D. It adds particle-based fluid and soft-body simulation to Box2D's rigid body capabilities. LiquidFun can be built for many different systems, including Android, iOS, Windows, OS X, Linux, and JavaScript.",
        "source_link": "https://github.com/google/liquidfun"
      }
    }
