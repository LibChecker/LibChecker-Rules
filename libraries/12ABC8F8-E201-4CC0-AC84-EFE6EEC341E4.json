      "data": {
        "label": "ZBar",
        "dev_team": "spadix",
        "rule_contributors": [
          "culat",
          "Absinthe"
        ],
        "description": "ZBar is an open-source software suite for reading barcodes from various sources. It supports many popular barcode types, including EAN-13/UPC-A, UPC-E, EAN-8, Code 128, Code 39, Interleaved 2 of 5, and QR Code.",
        "source_link": "http://zbar.sourceforge.net/"
      }
    }
