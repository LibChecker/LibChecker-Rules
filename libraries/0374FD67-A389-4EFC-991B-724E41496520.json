  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "Matrix",
        "dev_team": "Tencent",
        "rule_contributors": [
          "Absinthe",
          "yfdyh000",
          "ArthurCyy",
          "WOLFRAZOR"
        ],
        "description": "Matrix 是一款微信研发并日常使用的应用性能接入框架，支持 iOS, macOS 和Android。 Matrix 通过接入各种性能监控方案，对性能监控项的异常数据进行采集和分析，输出相应的问题分析、定位与优化建议，从而帮助开发者开发出更高质量的应用。",
        "source_link": "https://github.com/Tencent/matrix/"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Matrix",
        "dev_team": "Tencent",
        "rule_contributors": [
          "Absinthe",
          "yfdyh000",
          "ArthurCyy",
          "WOLFRAZOR"
        ],
        "description": "Matrix is an application performance access framework developed and used daily by WeChat, supporting iOS, macOS, and Android. By accessing various performance monitoring solutions, Matrix collects and analyzes abnormal data of performance monitoring items, outputting corresponding problem analysis, positioning, and optimization suggestions, thus helping developers develop higher quality applications.",
        "source_link": "https://github.com/Tencent/matrix/"
      }
    }
  ],
