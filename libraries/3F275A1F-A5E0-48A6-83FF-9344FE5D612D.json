{
  "schemaVersion": 5,
  "uuid": "3F275A1F-A5E0-48A6-83FF-9344FE5D612D",
  "iconId": null,
  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "PictureSelector",
        "dev_team": "LuckSiege",
        "rule_contributors": [
          "Absinthe",
          "Super12138"
        ],
        "description": "一款针对 Android 平台下的图片选择器，支持从相册获取图片、视频、音频 & 拍照，支持裁剪(单图 or 多图裁剪)、压缩、主题自定义配置等功能，支持动态获取权限&适配 Android 5.0+ 系统的开源图片选择框架。",
        "source_link": "https://github.com/LuckSiege/PictureSelector"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "PictureSelector",
        "dev_team": "LuckSiege",
        "rule_contributors": [
          "Absinthe",
          "Super12138"
        ],
        "description": "An image picker for the Android platform, supporting image, video, and audio retrieval from the album & taking photos, supporting cropping (single or multiple image cropping), compression, theme customization configuration, and more, supporting dynamic permission acquisition & adapting to the Android 5.0+ system open-source image selection framework.",
        "source_link": "https://github.com/LuckSiege/PictureSelector"
      }
    }
  ],
