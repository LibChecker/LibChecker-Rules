  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "Intune App SDK",
        "dev_team": "Microsoft",
        "rule_contributors": [
          "sebastien46"
        ],
        "description": "适用于 Android 的 Microsoft Intune App SDK 允许你将 Intune 应用保护策略集成到原生 Java/Kotlin Android 应用中。这些策略也称为 MAM 策略。由 Intune 管理的应用是指已集成 Intune App SDK 的应用。当 Intune 主动管理应用时，Intune 管理员可以轻松地将应用保护策略部署到你的 Intune 托管应用。",
        "source_link": "https://github.com/microsoftconnect/ms-intune-app-sdk-android"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Intune App SDK",
        "dev_team": "Microsoft",
        "rule_contributors": [
          "sebastien46"
        ],
        "description": "The Microsoft Intune App SDK for Android lets you incorporate Intune app protection policies into your native Java/Kotlin Android app. These policies are also known as MAM policies. An Intune-managed application is one that is integrated with the Intune App SDK. When Intune actively manages the app, Intune administrators can easily deploy app protection policies to your Intune-managed app.",
        "source_link": "https://github.com/microsoftconnect/ms-intune-app-sdk-android"
      }
    }
  ],
