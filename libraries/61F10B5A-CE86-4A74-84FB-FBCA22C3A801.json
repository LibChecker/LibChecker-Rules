  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "Mira",
        "dev_team": "ByteDance",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "插件服务包括插件核心库、插件管理库、插件构建脚本、插件管理平台 4 个功能模块，是一套完整的插件闭环服务。具有功能全面、稳定性强、使用简单等特点，可以帮助您实现业务热更新、降低首包体积、节省流量、模块化开发。",
        "source_link": "https://www.volcengine.com/docs/6365/67052"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Mira",
        "dev_team": "ByteDance",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "Plugin services include four functional modules: plugin core library, plugin management library, plugin build script, and plugin management platform, forming a complete plugin closed-loop service. It features comprehensive functionality, strong stability, and ease of use, helping you achieve business hot updates, reduce the first package size, save traffic, and modular development.",
        "source_link": "https://www.volcengine.com/docs/6365/67052"
      }
    }
  ],
