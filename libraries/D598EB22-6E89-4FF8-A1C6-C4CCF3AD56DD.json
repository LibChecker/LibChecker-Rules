    {
      "locale": "zh-Hans",
      "data": {
        "label": "IJKPlayer",
        "dev_team": "Bilibili",
        "rule_contributors": [
          "Absinthe",
          "crrashh1542"
        ],
        "description": "IJKPlayer 是一款基于 FFmpeg 的轻量级 Android/iOS 视频播放器，具有 API 易于集成、编译配置可裁剪、支持硬件加速解码、DanmakuFlameMaster 架构清晰、简单易用等优势。",
        "source_link": "https://github.com/bilibili/ijkplayer/"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "IJKPlayer",
        "dev_team": "Bilibili",
        "rule_contributors": [
          "Absinthe",
          "crrashh1542"
        ],
        "description": "IJKPlayer is a lightweight Android/iOS video player based on FFmpeg, with advantages such as easy-to-integrate APIs, customizable compile configurations, support for hardware-accelerated decoding, a clear DanmakuFlameMaster architecture, and ease of use.",
        "source_link": "https://github.com/bilibili/ijkplayer/"
      }
    }
  ],
