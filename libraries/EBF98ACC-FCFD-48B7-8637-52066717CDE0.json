      "data": {
        "label": "FreeType",
        "dev_team": "FreeType",
        "rule_contributors": [
          "nullptr-leo",
          "WOLFRAZOR"
        ],
        "description": "FreeType is a free software library for rendering fonts. It is written in C and aims to be small, efficient, highly customizable, and portable while being able to generate high-quality output (glyph images) for most vector and bitmap font formats.",
        "source_link": "https://www.freetype.org/"
      }
    }
