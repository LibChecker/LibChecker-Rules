  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "Donut",
        "dev_team": "Tencent",
        "rule_contributors": [
          "enKl03B",
          "ArcticFoxPro"
        ],
        "description": "Donut 多端框架是支持使用小程序技术和工具开发移动应用的框架，开发者可以一次编码，分别编译为小程序和 Android 以及 iOS 应用，实现多端开发；能帮助企业有效降低多端应用开发的技术门槛和研发成本，以及提升开发效率和开发体验。",
        "source_link": "https://dev.weixin.qq.com/docs/miniapp/intro"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Donut",
        "dev_team": "Tencent",
        "rule_contributors": [
          "enKl03B",
          "ArcticFoxPro"
        ],
        "description": "The Donut multi-end framework supports using mini program technologies and tools to develop mobile applications. Developers can write code once and compile it into mini programs, Android apps, and iOS apps, enabling cross-platform development. It helps enterprises effectively reduce the technical barriers and R&D costs of multi-end application development, while improving development efficiency and experience.",
        "source_link": "https://dev.weixin.qq.com/docs/miniapp/intro"
      }
    }
  ],
