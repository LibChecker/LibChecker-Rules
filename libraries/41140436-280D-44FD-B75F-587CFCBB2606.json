        "label": "智齿客服 SDK",
        "dev_team": "智齿科技",
        "rule_contributors": [
          "Absinthe",
          "ArthurCyy"
        ],
        "description": "智齿客服 SDK 是客服系统访客端的解决方案，既包含了客服聊天逻辑管理，也提供了聊天界面，开发者可方便的将客服功能集成到自己的 App 中。",
        "source_link": "https://www.sobot.com/developerdocs/app_sdk/"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Zhichi Customer Service SDK",
        "dev_team": "智齿科技",
        "rule_contributors": [
          "Absinthe",
          "ArthurCyy"
        ],
        "description": "Zhichi Customer Service SDK is a solution for the visitor side of the customer service system, including customer service chat logic management and providing a chat interface, allowing developers to easily integrate customer service functionality into their apps.",
        "source_link": "https://www.sobot.com/developerdocs/app_sdk/"
      }
    }
