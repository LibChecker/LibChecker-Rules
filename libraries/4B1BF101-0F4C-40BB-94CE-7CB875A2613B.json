  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "Google Play Services",
        "dev_team": "Google",
        "rule_contributors": [
          "Absinthe",
          "sebastien46"
        ],
        "description": "借助 Google Play 服务，你的应用可以使用 Google 提供的最新功能，例如地图和 Google+，并通过 Google Play 商店以 APK 形式分发自动平台更新。这可以让用户更快地获得更新，也能更轻松地集成 Google 提供的最新信息。",
        "source_link": "https://developers.google.com/android/guides/overview/"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Google Play Services",
        "dev_team": "Google",
        "rule_contributors": [
          "Absinthe",
          "sebastien46"
        ],
        "description": "With Google Play services, your app can take advantage of the latest features provided by Google, such as maps and Google+, and distribute automatic platform updates via the Google Play store in APK form. This allows your users to receive updates more quickly and integrates the latest information Google has to offer more easily.",
        "source_link": "https://developers.google.com/android/guides/overview/"
      }
    }
  ],
