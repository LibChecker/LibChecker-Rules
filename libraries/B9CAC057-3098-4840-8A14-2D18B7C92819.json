  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "mPaaS",
        "dev_team": "Alibaba",
        "rule_contributors": [
          "Absinthe",
          "yfdyh000",
          "ArthurCyy",
          "WOLFRAZOR"
        ],
        "description": "移动开发平台（Mobile PaaS，简称 mPaaS）是源于支付宝 App 的移动开发平台，为移动开发、测试、运营及运维提供云到端的一站式解决方案，能有效降低技术门槛、减少研发成本、提升开发效率，协助企业快速搭建稳定高质量的移动 App。",
        "source_link": "https://help.aliyun.com/document_detail/49549.html"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "mPaaS",
        "dev_team": "Alibaba",
        "rule_contributors": [
          "Absinthe",
          "yfdyh000",
          "ArthurCyy",
          "WOLFRAZOR"
        ],
        "description": "Mobile PaaS (mPaaS) is a mobile development platform originating from the Alipay app, providing a one-stop solution from cloud to end for mobile development, testing, operation, and maintenance, effectively reducing technical barriers, reducing R&D costs, improving development efficiency, and assisting enterprises in quickly building stable and high-quality mobile apps.",
        "source_link": "https://help.aliyun.com/document_detail/49549.html"
      }
    }
  ],
