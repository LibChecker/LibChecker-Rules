  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "腾讯云 HTTPDNS",
        "dev_team": "Tencent",
        "rule_contributors": [
          "su1216",
          "crrashh1542"
        ],
        "description": "HTTPDNS 基于 HTTP 协议向腾讯云的 DNS 服务器发送域名解析请求，替代了基于 DNS 协议向运营商 LocalDNS 发起解析请求的传统方式，可以避免 LocalDNS 造成的域名劫持和跨网访问问题，解决移动互联网服务中域名解析异常带来的困扰。",
        "source_link": "https://github.com/tencentyun/httpdns-android-sdk"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Tencent Cloud HTTPDNS",
        "dev_team": "Tencent",
        "rule_contributors": [
          "su1216",
          "crrashh1542"
        ],
        "description": "HTTPDNS sends domain name resolution requests to Tencent Cloud's DNS server based on the HTTP protocol, replacing the traditional method of initiating resolution requests to the operator's LocalDNS based on the DNS protocol. This can avoid domain hijacking and cross-network access issues caused by LocalDNS, solving the troubles brought by domain resolution anomalies in mobile internet services.",
        "source_link": "https://github.com/tencentyun/httpdns-android-sdk"
      }
    }
  ],
