      "data": {
        "label": "HMS Video Kit",
        "dev_team": "Huawei",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "Video Service (Video Kit) provides video playback and HDR Vivid video processing services. In the future, it will offer video editing and video hosting services, helping you quickly build video features and provide a video media experience to users.",
        "source_link": "https://developer.huawei.com/consumer/cn/doc/development/Media-Guides/introduction-0000001050439577"
      }
