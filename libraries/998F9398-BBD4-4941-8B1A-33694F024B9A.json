  "data": [
    {
      "locale": "zh-Hans",
      "data": {
        "label": "阿里移动推送",
        "dev_team": "Aliyun",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "阿里移动推送（Alibaba Cloud Mobile Push）是基于大数据的移动智能推送服务，帮助 App 快速集成移动推送的功能，在实现高效、精确、实时的移动推送的同时，极大地降低了开发成本。让开发者最有效地与用户保持连接，从而提高用户活跃度、提高应用的留存率。",
        "source_link": "https://help.aliyun.com/product/30047.html/"
      }
    },
    {
      "locale": "en",
      "data": {
        "label": "Alibaba Mobile Push",
        "dev_team": "Aliyun",
        "rule_contributors": [
          "Absinthe"
        ],
        "description": "Alibaba Cloud Mobile Push is a mobile intelligent push service based on big data, helping apps quickly integrate mobile push functionality, achieving efficient, precise, real-time mobile push while significantly reducing development costs. It allows developers to effectively maintain connections with users, thereby increasing user activity and app retention rates.",
        "source_link": "https://help.aliyun.com/product/30047.html/"
      }
    }
  ],
