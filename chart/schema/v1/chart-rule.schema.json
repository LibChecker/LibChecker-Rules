{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/LibChecker/LibChecker-Rules/chart/schema/v1/chart-rule.schema.json",
    "title": "LibChecker chart rule",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "revision",
        "source",
        "title",
        "icon",
        "calculation"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^official\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "revision": {
            "type": "integer",
            "minimum": 1
        },
        "source": {
            "const": "official"
        },
        "title": {
            "$ref": "#/$defs/text"
        },
        "icon": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "asset"
            ],
            "properties": {
                "asset": {
                    "type": "string",
                    "pattern": "^icons/[a-z0-9][a-z0-9._-]*\\.svg$"
                },
                "renderMode": {
                    "enum": [
                        "monochrome",
                        "original"
                    ],
                    "default": "monochrome"
                },
                "tintRole": {
                    "enum": [
                        "on_surface",
                        "on_surface_variant",
                        "primary",
                        "secondary",
                        "tertiary"
                    ],
                    "default": "on_surface"
                }
            }
        },
        "calculation": {
            "oneOf": [
                {
                    "$ref": "#/$defs/predicateCalculation"
                }
            ]
        },
        "availability": {
            "enum": [
                "always"
            ],
            "default": "always"
        },
        "requiresFeatureInitialization": {
            "type": "boolean",
            "default": false
        },
        "controls": {
            "type": "array",
            "maxItems": 0
        },
        "dashboard": {
            "const": "none",
            "default": "none"
        },
        "fingerprint": {
            "enum": [
                "standard",
                "features",
                "artifact"
            ],
            "default": "standard"
        }
    },
    "$defs": {
        "text": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "translations"
            ],
            "properties": {
                "translations": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 16,
                    "propertyNames": {
                        "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
                    },
                    "additionalProperties": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    }
                }
            }
        },
        "value": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "integer": {
                    "type": "integer"
                },
                "string": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                }
            },
            "oneOf": [
                {
                    "required": [
                        "integer"
                    ]
                },
                {
                    "required": [
                        "string"
                    ]
                }
            ]
        },
        "predicateCalculation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "predicate"
            ],
            "properties": {
                "kind": {
                    "const": "predicate"
                },
                "predicate": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "evidence",
                        "operator",
                        "value",
                        "matchedTitle",
                        "unmatchedTitle"
                    ],
                    "properties": {
                        "evidence": {
                            "enum": [
                                "target_sdk",
                                "native_library"
                            ]
                        },
                        "operator": {
                            "enum": [
                                "equal",
                                "greater_than_or_equal",
                                "less_than_or_equal",
                                "contains"
                            ]
                        },
                        "value": {
                            "$ref": "#/$defs/value"
                        },
                        "matchedTitle": {
                            "$ref": "#/$defs/text"
                        },
                        "unmatchedTitle": {
                            "$ref": "#/$defs/text"
                        }
                    },
                    "allOf": [
                        {
                            "if": {
                                "properties": {
                                    "evidence": {
                                        "const": "target_sdk"
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "operator": {
                                        "enum": [
                                            "equal",
                                            "greater_than_or_equal",
                                            "less_than_or_equal"
                                        ]
                                    },
                                    "value": {
                                        "required": [
                                            "integer"
                                        ]
                                    }
                                }
                            }
                        },
                        {
                            "if": {
                                "properties": {
                                    "evidence": {
                                        "const": "native_library"
                                    }
                                }
                            },
                            "then": {
                                "properties": {
                                    "operator": {
                                        "const": "contains"
                                    },
                                    "value": {
                                        "required": [
                                            "string"
                                        ],
                                        "properties": {
                                            "string": {
                                                "pattern": "^[A-Za-z0-9._+-]{1,160}$"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        }
    }
}
