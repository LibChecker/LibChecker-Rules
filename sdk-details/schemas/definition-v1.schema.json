{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libchecker.github.io/schemas/sdk-details/definition-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "sdk_id",
    "target_uuids",
    "probes",
    "presentation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sdk_id": {
      "$ref": "#/$defs/identifier"
    },
    "target_uuids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "lookups": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/lookup"
      }
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
    },
    "probe": {
      "type": "object",
      "required": ["id", "source", "reader", "captures"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "type": "object",
          "required": ["operator", "file_name", "archive_paths"],
          "additionalProperties": false,
          "properties": {
            "operator": {
              "const": "package_file"
            },
            "file_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^/\\\\]+$"
            },
            "archive_paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              }
            }
          }
        },
        "reader": {
          "type": "object",
          "required": ["operator", "max_bytes_per_file", "max_total_bytes"],
          "additionalProperties": false,
          "properties": {
            "operator": {
              "const": "ascii_strings"
            },
            "max_bytes_per_file": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "max_total_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 134217728
            }
          }
        },
        "captures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["output", "type", "max_results"],
            "additionalProperties": false,
            "properties": {
              "output": {
                "$ref": "#/$defs/identifier"
              },
              "type": {
                "enum": ["sha1", "semver_channel"]
              },
              "max_results": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              }
            }
          }
        }
      }
    },
    "lookup": {
      "type": "object",
      "required": ["input", "path_template", "max_requests", "max_items", "outputs"],
      "additionalProperties": false,
      "properties": {
        "input": {
          "$ref": "#/$defs/identifier"
        },
        "path_template": {
          "type": "string",
          "pattern": "^sdk-details/[A-Za-z0-9_./{}-]*\\{value\\}[A-Za-z0-9_./{}-]*$"
        },
        "expected_field": {
          "$ref": "#/$defs/identifier"
        },
        "items_field": {
          "$ref": "#/$defs/identifier"
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["output", "field"],
            "additionalProperties": false,
            "properties": {
              "output": {
                "$ref": "#/$defs/identifier"
              },
              "field": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "presentationField": {
      "type": "object",
      "required": ["label", "source", "max_values"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "object",
          "required": ["default"],
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "max_values": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "presentation": {
      "type": "object",
      "required": ["summary"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/presentationField"
          }
        },
        "details": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/presentationField"
          }
        }
      }
    }
  }
}
