{
  "schema_version": 2,
  "sdk_id": "androidx_camera",
  "target_uuids": [
    "B670C354-BD62-41EB-9FEF-D50E0208EC40"
  ],
  "probes": [
    {
      "id": "camera_core",
      "source": {
        "operator": "package_file",
        "file_name": "androidx.camera_camera-core.version",
        "archive_paths": [
          "META-INF/androidx.camera_camera-core.version"
        ]
      },
      "reader": {
        "operator": "ascii_strings",
        "max_bytes_per_file": 256,
        "max_total_bytes": 2048
      },
      "captures": [
        {
          "output": "versions",
          "type": "semver",
          "max_results": 8
        }
      ]
    }
  ],
  "presentation": {
    "summary": [
      {
        "label": {
          "default": "Version",
          "zh-Hans": "版本"
        },
        "source": "versions",
        "max_values": 8
      }
    ]
  }
}
