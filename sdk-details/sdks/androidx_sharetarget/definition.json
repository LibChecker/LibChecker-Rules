{
  "schema_version": 2,
  "sdk_id": "androidx_sharetarget",
  "target_uuids": [
    "E345D252-9789-480A-8D3A-1316A09D142D"
  ],
  "probes": [
    {
      "id": "sharetarget",
      "source": {
        "operator": "package_file",
        "file_name": "androidx.sharetarget_sharetarget.version",
        "archive_paths": [
          "META-INF/androidx.sharetarget_sharetarget.version"
        ]
      },
      "reader": {
        "operator": "ascii_strings",
        "max_bytes_per_file": 256,
        "max_total_bytes": 2048
      },
      "captures": [
        {
          "output": "versions",
          "type": "semver",
          "max_results": 8
        }
      ]
    }
  ],
  "presentation": {
    "summary": [
      {
        "label": {
          "default": "Version",
          "zh-Hans": "版本"
        },
        "source": "versions",
        "max_values": 8
      }
    ]
  }
}
