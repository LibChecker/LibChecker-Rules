{
  "schema_version": 2,
  "sdk_id": "androidx_lifecycle",
  "target_uuids": [
    "1987147A-53F5-4C2B-8913-C56CF3C84BA6"
  ],
  "probes": [
    {
      "id": "lifecycle_process",
      "source": {
        "operator": "package_file",
        "file_name": "androidx.lifecycle_lifecycle-process.version",
        "archive_paths": [
          "META-INF/androidx.lifecycle_lifecycle-process.version"
        ]
      },
      "reader": {
        "operator": "ascii_strings",
        "max_bytes_per_file": 256,
        "max_total_bytes": 2048
      },
      "captures": [
        {
          "output": "versions",
          "type": "semver",
          "max_results": 8
        }
      ]
    }
  ],
  "presentation": {
    "summary": [
      {
        "label": {
          "default": "Version",
          "zh-Hans": "版本"
        },
        "source": "versions",
        "max_values": 8
      }
    ]
  }
}
